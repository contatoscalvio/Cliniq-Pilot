CLAUDE_MODEL=claude-sonnet-5

# --- Supabase ---
SUPABASE_URL=https://pkbezuzucrsnrvmzpkbi.supabase.co
SUPABASE_SERVICE_KEY=

# --- Evolution API ---
EVOLUTION_API_URL=https://evolution-api-production-ff55.up.railway.app
